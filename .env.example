# File: TRAFFIC_SYSTEM_FE/.env.example
# Template mẫu - copy thành .env rồi chỉnh giá trị theo máy của bạn.
# Biến phải có prefix VITE_ để được Vite expose vào mã client.

# Base URL của Backend API (FastAPI)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# URL health check (nằm ngoài prefix /v1)
VITE_API_HEALTH_URL=http://127.0.0.1:8000/api/health

# Nguồn ảnh nền bản đồ (OpenStreetMap tiles)
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Dịch vụ geocoding (địa chỉ -> tọa độ)
VITE_GEOCODER_URL=https://nominatim.openstreetmap.org/search

# Dịch vụ định tuyến (OSRM)
VITE_ROUTING_URL=https://router.project-osrm.org/route/v1/driving

# Khung giới hạn tìm địa điểm: Hà Nội
VITE_SEARCH_VIEWBOX=105.3,21.5,106.1,20.5
